# CPU_TUNE_ROOT points all paths at a fake file system tree, for tests.
# Then cpu-tune does not run sudo, and it does not put load on real CPUs.
TEST_MODE = "CPU_TUNE_ROOT" in os.environ
ROOT = Path(os.environ.get("CPU_TUNE_ROOT", "/"))
CPU_BASE = ROOT / "sys/devices/system/cpu"
STATE_FILE = ROOT / "run/cpu-tune.json"
STATE_SHOWN = "/run/cpu-tune.json"
USER_BIN = ROOT / "home/.local/bin" if TEST_MODE else Path.home() / ".local/bin"
SYSTEM_BIN = ROOT / "usr/local/bin"

COMMANDS = ("show", "watch", "lock", "run", "limit", "reset", "sudoers", "install", "update")

