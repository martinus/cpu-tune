def cmd_show(args: argparse.Namespace) -> None:
    if args.watch:
        cmd_watch(args)
        return
    cores = get_cores()
    if args.now:
        now = measure([cpu for c in cores if c.has_freq for cpu in c.cpus])
        for core in cores:
            core.now = max((now.get(cpu, 0) for cpu in core.cpus), default=0) or None
    info = system_info()
    checks = run_checks(None)  # the machine only: at once, no load measurement
    if args.json:
        print_json(show_json(cores, info, "show") | {"checks": checks})
        return
    lines = render_show(cores, info, args.now)
    # "changed" is in render_show already. The other notes: what can make results vary.
    if notes := [item for item in checks if item["level"] != "ok" and item["name"] != "changed"]:
        lines += ["", *render_checks(notes)]
    say("\n".join(lines))


class FdReader:
    """Reads sysfs values through file descriptors that stay open.

    pread() at offset 0 makes the kernel generate a sysfs value again, so one
    update costs one system call per file: no open, no close, no path lookup.
    """

    def __init__(self) -> None:
        self.fds: dict[str, int] = {}

    def int(self, path: Path) -> int | None:
        key = str(path)
        try:
            if (fd := self.fds.get(key)) is None:
                fd = self.fds[key] = os.open(key, os.O_RDONLY | os.O_CLOEXEC)
            return int(os.pread(fd, 32, 0))
        except (OSError, ValueError):
            return None

    def close(self) -> None:
        for fd in self.fds.values():
            os.close(fd)
        self.fds.clear()


def stay_away_from_benchmarks(allowed: set[int]) -> None:
    """Run only on the allowed CPUs that cputune did not lock: watch must not disturb a benchmark."""
    try:
        if keep := allowed - set(state_cpus() or []):
            os.sched_setaffinity(0, keep)
    except OSError:
        pass


def cmd_watch(args: argparse.Namespace) -> None:
    """A live view. To keep its own load low, watch wakes up once per interval,
    reads only the files that change, and redraws only the lines that change."""
    if args.interval <= 0:
        die("--interval must be more than 0")
    tty = not args.json and OUT.isatty()
    reader = FdReader()
    rescan_every = 5.0  # seconds; topology, ranks and system info rarely change
    next_rescan = 0.0
    cores: list[Core] = []
    info: dict = {}
    sources: dict[int, Path] = {}
    shown: list[str] = []
    columns = 0
    frames = 0
    allowed = os.sched_getaffinity(0)
    try:
        os.nice(19 - os.nice(0))  # lowest priority
    except OSError:
        pass
    if tty:
        OUT.write("\033[?1049h\033[?25l")  # alternate screen, hide cursor
    try:
        deadline = time.monotonic()
        while True:
            if time.monotonic() >= next_rescan:
                reader.close()
                stay_away_from_benchmarks(allowed)  # the locked CPUs can change
                cores, info = get_cores(), system_info()
                sources = {}
                for cpu in (cpu for c in cores if c.has_freq for cpu in c.cpus):
                    avg = fdir(cpu) / "cpuinfo_avg_freq"
                    sources[cpu] = avg if read_int(avg) is not None else fdir(cpu) / "scaling_cur_freq"
                next_rescan = time.monotonic() + rescan_every
            else:
                for core in cores:  # lock, limit and boost change these
                    if core.has_freq:
                        d = fdir(core.cpus[0])
                        for attr, name in (("hw_min", "cpuinfo_min_freq"), ("hw_max", "cpuinfo_max_freq"),
                                           ("set_min", "scaling_min_freq"), ("set_max", "scaling_max_freq")):
                            if (khz := reader.int(d / name)) is not None:
                                setattr(core, attr, khz // 1000)
            for core in cores:
                now = [reader.int(sources[cpu]) or 0 for cpu in core.cpus if cpu in sources]
                core.now = max(now, default=0) // 1000 or None

            if args.json:
                data = show_json(cores, info, "watch")
                data["time"] = time.time()
                print(json.dumps(data), file=OUT, flush=True)
            else:
                lines = render_show(cores, info, True)
                lines.append(paint(f"{time.strftime('%H:%M:%S')}   Ctrl+C to stop", GRAY))
                if not tty:
                    OUT.write("\n".join(lines) + "\n\n")
                else:
                    width = shutil.get_terminal_size().columns
                    if width != columns:  # new size: draw everything again
                        columns, shown = width, []
                        OUT.write("\033[H\033[J")
                    out = [
                        f"\033[{row + 1};1H{line}\033[K"
                        for row, line in enumerate(lines)
                        if row >= len(shown) or shown[row] != line
                    ]
                    if len(lines) < len(shown):
                        out.append(f"\033[{len(lines) + 1};1H\033[J")
                    OUT.write("".join(out))
                    shown = lines
                OUT.flush()

            frames += 1
            if args.count and frames >= args.count:
                break
            deadline += args.interval
            if (wait := deadline - time.monotonic()) > 0:
                time.sleep(wait)
            else:
                deadline = time.monotonic()  # too slow, or the machine was suspended
    except KeyboardInterrupt:
        pass
    finally:
        reader.close()
        if tty:
            OUT.write("\033[?25h\033[?1049l")
            OUT.flush()


# ------------------------------------------------------------------ check

# Services that change CPU settings on their own: while a benchmark runs, they can turn boost
# back on, or change EPP or the governor. Key: /proc/PID/comm, at most 15 characters.
POWER_SERVICES = {
    "power-profiles-": "power-profiles-daemon",
    "tuned": "tuned",
    "tuned-ppd": "tuned-ppd",
    "auto-cpufreq": "auto-cpufreq",
    "system76-power": "com.system76.PowerDaemon",
}


def cpu_times() -> dict[int, tuple[int, int]]:
    """Busy time and total time of each CPU since boot, from /proc/stat (in clock ticks)."""
    times = {}
    try:
        lines = (ROOT / "proc/stat").read_text().splitlines()
    except OSError:
        return times
    for line in lines:
        name, *values = line.split() or [""]
        if name.startswith("cpu") and name[3:].isdigit() and len(values) >= 5:
            try:
                ticks = [int(v) for v in values[:8]]  # user nice system idle iowait irq softirq steal
            except ValueError:
                continue
            total = sum(ticks)
            times[int(name[3:])] = (total - ticks[3] - ticks[4], total)
    return times


def busy_fractions(seconds: float) -> dict[int, float]:
    """How busy each CPU is (0.0 to 1.0), measured over some seconds."""
    before = cpu_times()
    time.sleep(0 if TEST_MODE else seconds)
    after = cpu_times()
    busy = {}
    for cpu in before.keys() & after.keys():
        if total := after[cpu][1] - before[cpu][1]:
            busy[cpu] = max(0.0, min(1.0, (after[cpu][0] - before[cpu][0]) / total))
    return busy


def running_services() -> list[str]:
    found = set()
    for path in (ROOT / "proc").glob("[0-9]*/comm"):
        if (service := POWER_SERVICES.get(read_str(path) or "")) is not None:
            found.add(service)
    return sorted(found)


def load_checks(cpus: list[int], seconds: float, add) -> None:
    """Other load on the benchmark core and on the machine."""
    cpu_text = format_cpu_list(cpus)
    try:  # do not measure the load that this check puts on the CPUs
        if others := set(os.sched_getaffinity(0)) - set(cpus):
            os.sched_setaffinity(0, others)
    except OSError:
        pass
    busy = busy_fractions(seconds)
    if busy:
        loaded = [cpu for cpu in cpus if busy.get(cpu, 0) >= 0.1]
        if loaded:
            used = ", ".join(f"cpu {cpu} {busy[cpu]:.0%}" for cpu in loaded)
            add("warn", "load", f"Other programs use the benchmark core: {used} busy. They slow it down.",
                "Stop these programs, or choose another core with --cpu.")
        else:
            add("ok", "load", f"No other load on cpu {cpu_text}.")
        if (machine := sum(busy.values()) / len(busy)) >= 0.25:
            add("warn", "machine load", f"The machine is {machine:.0%} busy. Programs on other cores share "
                "caches, memory and the power limit with the benchmark.", "Stop other programs.")


def run_checks(cpus: list[int] | None, seconds: float = 0.5) -> list[dict]:
    """Things that make benchmark results vary. Reads only, needs no root.

    With cpus: also the load on these CPUs (measured for some seconds), and CPU 0.
    Without: only the machine, at once. Each item: name, level ("ok", "note" or "warn"),
    text, and fix (None when ok).
    """
    items: list[dict] = []

    def add(level: str, name: str, text: str, fix: str | None = None) -> None:
        items.append({"name": name, "level": level, "text": text, "fix": fix})

    if (changed := state_cpus()) is not None:
        add("warn", "changed", f"cputune already changed cpu {format_cpu_list(changed) or '?'}. "
            "cputune run does not start then.", "cputune reset")

    if cpus:
        load_checks(cpus, seconds, add)

    if services := running_services():
        names = " and ".join([", ".join(services[:-1]), services[-1]] if len(services) > 1 else services)
        one = len(services) == 1
        add("note", "service", f"{names} {'runs' if one else 'run'}: power service{'' if one else 's'} of the "
            f"system, not started by cputune. {'It' if one else 'They'} can change CPU settings. cputune run "
            "warns when this changes a lock.",
            f"To stop {'it' if one else 'them'} until the next reboot: sudo systemctl stop {' '.join(services)}")
    else:
        add("ok", "service", "No power service runs (power-profiles-daemon, tuned, auto-cpufreq).")

    online = []
    for supply in (ROOT / "sys/class/power_supply").glob("*"):
        if read_str(supply / "type") in ("Mains", "USB") and (value := read_int(supply / "online")) is not None:
            online.append(value)
    if online and not any(online):
        add("warn", "battery", "The computer runs on battery. Then the CPU often has lower power limits.",
            "Connect the power supply.")
    elif online:
        add("ok", "battery", "The power supply is connected.")

    if (aslr := read_int(ROOT / "proc/sys/kernel/randomize_va_space")) is not None:
        if aslr:
            add("note", "aslr", "ASLR is on: memory addresses change with each run. This can change the "
                "result a little.",
                "Turn it off for one command: setarch -R COMMAND")
        else:
            add("ok", "aslr", "ASLR is off.")

    if cpus and 0 in cpus:
        add("note", "cpu 0", "CPU 0 often handles more interrupts than the other CPUs.",
            "Choose another core with --cpu.")
    return items


def render_checks(items: list[dict], indent: str = "") -> list[str]:
    """The items, problems first, wrapped to the terminal width."""
    marks = {"ok": paint("✓", BOLD, GREEN), "note": paint("·", BOLD, BLUE), "warn": paint("!", BOLD, YELLOW)}
    width = max(40, shutil.get_terminal_size((100, 24)).columns) - len(indent) - 2
    lines = []
    for item in sorted(items, key=lambda i: ("warn", "note", "ok").index(i["level"])):
        for n, line in enumerate(textwrap.wrap(item["text"], width)):
            lines.append(f"{indent}{marks[item['level']] if n == 0 else ' '} {line}")
        for line in textwrap.wrap(item["fix"] or "", width):
            lines.append(paint(f"{indent}  {line}", GRAY))
    return lines


def cmd_check(args: argparse.Namespace) -> None:
    """Hidden since 2.4.0: cputune shows these notes, and run checks the load. Kept for scripts."""
    cpus = select_cpus(args.cpu, [] if args.cpu else list(default_lock_core(get_cores()).cpus))
    items = run_checks(cpus)
    warnings = sum(item["level"] == "warn" for item in items)
    if args.json:
        print_json({"ok": True, "command": "check", "cpus": cpus, "clean": not warnings, "checks": items})
        return
    which = "" if args.cpu else paint(" (the core that lock and run use)", GRAY)
    say(f"What can make results vary on cpu {paint(format_cpu_list(cpus), BOLD, WHITE)}{which}:")
    say("\n".join(render_checks(items, "  ")))
    say()
    if warnings:
        say(paint(f"{warnings} problem{'s' if warnings > 1 else ''} can make results vary.", BOLD, YELLOW))
    else:
        say(paint("✓ ", BOLD, GREEN) + "Nothing found that makes results vary.")


# ------------------------------------------------------------------ root


def script_path() -> str:
    """The path as the user called it. A sudo rule matches this path."""
    return os.path.abspath(sys.argv[0])


def root_copy() -> str:
    """The copy of cputune that runs as root.

    This file, when only root can change it. Else the root-owned /usr/local/bin/cputune,
    when it exists: the sudo rule names that copy, and root must not run a file that the
    user can change. Else this file (sudo then asks for a password).
    """
    script = script_path()
    if owned_by_root(Path(script)):
        return script
    system = SYSTEM_BIN / "cputune"
    if owned_by_root(system):
        mine, theirs = file_version(Path(script)), file_version(system)
        if version_key(theirs) < version_key(mine):
            warn(f"root runs {system} {theirs}, which is older than this copy ({mine}). "
                 f"Update it with: {self_command()} install")
        return str(system)
    return script


def file_version(path: Path) -> str | None:
    try:
        return source_version(path.read_bytes())
    except OSError:
        return None


def root_command(argv: list[str]) -> list[str]:
    """The command that runs cputune with argv as root."""
    script = script_path()
    if os.geteuid() == 0 or TEST_MODE:
        return [sys.executable, script, *argv]
    copy = root_copy()
    run = [copy] if os.access(copy, os.X_OK) else [sys.executable, copy]
    if sys.stdin.isatty():
        return ["sudo", *run, *argv]
    return ["sudo", "-n", *run, *argv]  # no terminal: never wait for a password


def run_root(argv: list[str], capture: bool = False) -> subprocess.CompletedProcess:
    """Run cputune with argv as root. With capture=True, stdout is in the result."""
    cmd = root_command(argv)
    quiet_sudo = cmd[:2] == ["sudo", "-n"]
    sys.stdout.flush()
    result = subprocess.run(
        cmd,
        stdout=subprocess.PIPE if capture else None,
        stderr=subprocess.PIPE if quiet_sudo else None,
        text=True,
    )
    if quiet_sudo:
        if result.returncode != 0 and result.stderr.startswith("sudo:"):
            die(
                f"needs root, but sudo cannot run without a password here "
                f"({result.stderr.strip()}). Run cputune in a terminal, or allow it "
                "without a password: cputune install --no-password"
            )
        sys.stderr.write(result.stderr)
    return result


def ensure_root(args: argparse.Namespace) -> None:
    """Run this command again as root, and exit with its exit code. No-op when root."""
    if os.geteuid() == 0 or TEST_MODE:
        return
    sys.exit(run_root(args.argv).returncode)


# ------------------------------------------------------------------ change settings


def write(path: Path, value: object, errors: list[str] | None = None) -> None:
    """Write a sysfs file. Stop on failure, or add the message to errors."""
    try:
        path.write_text(f"{value}\n")
    except OSError as e:
        msg = f"cannot write {value} to {path}: {e.strerror}"
        if errors is None:
            die(msg)
        errors.append(msg)


def set_range(cpu: int, lo_khz: int, hi_khz: int, errors: list[str] | None = None) -> None:
    """Set scaling_min_freq and scaling_max_freq. Open the range first, so every write is valid."""
    d = fdir(cpu)
    write(d / "scaling_min_freq", must_khz(cpu, "cpuinfo_min_freq"), errors)
    write(d / "scaling_max_freq", hi_khz, errors)
    write(d / "scaling_min_freq", lo_khz, errors)


def save_state(cpus: list[int], exclusive: bool) -> None:
    """Save the original settings of these CPUs and their boost switches.

    A value that is already saved is never overwritten, so a second lock keeps
    the original values. This runs before any change, so reset works also when
    a later write fails. With exclusive=True, fail when cputune already changed
    something: then two benchmarks cannot use cputune at the same time.
    """
    existed = state_exists()
    if existed and exclusive:
        cpus_text = format_cpu_list(state_cpus() or [])
        die(f"cputune already changed cpu {cpus_text}. Undo it first with: cputune reset")
    state = load_state() if existed else {"version": 1, "boot_id": read_str(BOOT_ID), "cpus": {}, "boost": {}}

    for cpu in cpus:
        if str(cpu) not in state["cpus"]:
            d = fdir(cpu)
            state["cpus"][str(cpu)] = {
                "governor": read_str(d / "scaling_governor"),
                "epp": read_str(d / "energy_performance_preference"),
                "min": must_khz(cpu, "scaling_min_freq"),
                "max": must_khz(cpu, "scaling_max_freq"),
            }
        if (switch := boost_switch(cpu)) and str(switch[0]) not in state["boost"]:
            state["boost"][str(switch[0])] = read_str(switch[0])
    text = json.dumps(state, indent=2) + "\n"

    STATE_FILE.parent.mkdir(parents=True, exist_ok=True)
    if existed:
        tmp = STATE_FILE.with_suffix(".tmp")
        tmp.write_text(text)
        os.replace(tmp, STATE_FILE)
        return
    try:  # O_EXCL: when two cputune processes start at the same time, only one wins.
        fd = os.open(STATE_FILE, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
    except FileExistsError:
        die("another cputune changed settings at the same time. Check with: cputune show")
    with os.fdopen(fd, "w") as f:
        f.write(text)


def select_cpus(spec: str | None, default: list[int]) -> list[int]:
    """The CPUs of a --cpu value, with all their SMT siblings."""
    available = set(freq_cpus())
    if not available:
        die("no CPU has cpufreq (no cpufreq driver loaded?)")
    if spec is None:
        wanted = default
    elif spec.strip() == "all":
        wanted = sorted(available)
    else:
        try:
            wanted = parse_cpu_list(spec)
        except ValueError:
            die(f'bad CPU list "{spec}". Examples: 3, 2,3, 0-7, all')
    for cpu in wanted:
        if cpu not in available:
            die(f"cpu{cpu} has no cpufreq (it is offline, or it does not exist)")
    selected = set(wanted)
    for core in get_cores():
        if selected & set(core.cpus):
            selected |= set(core.cpus) & available
    return sorted(selected)


def parse_freq(text: str) -> int | str:
    """"2400", "2400MHz", "2.4GHz" -> 2400 (MHz). "base", "min", "max" stay words."""
    t = text.strip().lower().replace(" ", "")
    if t in ("base", "min", "max"):
        return t
    if m := re.fullmatch(r"(\d+(?:\.\d+)?)(ghz|mhz|g|m)?", t):
        return round(float(m[1]) * (1000 if m[2] in ("ghz", "g") else 1))
    raise argparse.ArgumentTypeError(
        f'bad frequency "{text}". Examples: 2400, 2400MHz, 2.4GHz, base, min, max'
    )


def target_khz(cpu: int, freq: int | str, clamp: bool) -> int:
    """The frequency in kHz for a FREQ value. Values outside the hardware range
    are clamped (clamp=True), or they are an error."""
    lo = must_khz(cpu, "cpuinfo_min_freq")
    hi = must_khz(cpu, "cpuinfo_max_freq")
    if freq == "min":
        return lo
    if freq == "max":
        return hi
    if freq == "base":
        return max(lo, min(base_khz(cpu, guess=True) or hi, hi))
    khz = int(freq) * 1000
    if clamp:
        return max(lo, min(khz, hi))
    if not lo <= khz <= hi:
        hint = f" Did you mean {freq}GHz?" if int(freq) < 100 else ""
        die(f"cpu{cpu}: {freq} MHz is outside {lo // 1000}-{hi // 1000} MHz.{hint}")
    return khz


def lowest_lock_khz(cpu: int) -> int:
    """The lowest frequency that a lock can hold. amd-pstate: the CPU does not follow a request
    below lowest_nonlinear_freq (Ryzen 9 7950X: 425 MHz requested, 2170 MHz measured)."""
    lowest = must_khz(cpu, "cpuinfo_min_freq")
    return max(lowest, read_int(fdir(cpu) / "amd_pstate_lowest_nonlinear_freq") or 0)


def cmd_lock(args: argparse.Namespace) -> None:
    freq = args.freq if args.freq is not None else "base"
    ensure_root(args)
    cpus = select_cpus(args.cpu, [] if args.cpu else list(default_lock_core(get_cores()).cpus))
    if isinstance(freq, int):
        for cpu in cpus:  # check before any change
            target_khz(cpu, freq, clamp=False)
            base = base_khz(cpu)
            if base and freq * 1000 > base + 1000:
                die(
                    f"cpu{cpu}: {freq} MHz is above the base frequency {base // 1000} MHz. "
                    "lock turns boost off, so it can lock at most the base frequency."
                )
    save_state(cpus, args.exclusive)

    # 1. Boost off. The hardware range can get smaller with it, so this comes first.
    switches = {}
    for cpu in cpus:
        if switch := boost_switch(cpu):
            switches[switch[0]] = switch
    for path, off, _ in switches.values():
        write(path, off)
    scope = "none" if not switches else "core" if all(s[2] == "core" for s in switches.values()) else "global"
    if scope == "none":
        warn("no boost switch found, boost stays as it is")

    # 2. Check all targets. The range is checked again, because boost is off now.
    targets = {}
    for cpu in cpus:
        try:
            targets[cpu] = lowest_lock_khz(cpu) if freq == "min" else target_khz(cpu, freq, clamp=False)
        except Error as e:
            die(f"{e} Boost is off now. Undo with: cputune reset")

    # 3. The performance governor, so the core does not drop below the minimum.
    # 4. Minimum = maximum = target.
    governors = set()
    for cpu, khz in targets.items():
        available = (read_str(fdir(cpu) / "scaling_available_governors") or "").split()
        if "performance" in available:
            write(fdir(cpu) / "scaling_governor", "performance")
        governors.add(read_str(fdir(cpu) / "scaling_governor") or "?")
        set_range(cpu, khz, khz)

    # Measure one CPU of each core under load: an idle core shows no useful value.
    groups = [g for core in get_cores() if (g := [c for c in core.cpus if c in targets])]
    now = measure_under_load([g[0] for g in groups])
    cores = []
    for siblings in groups:
        cpu = siblings[0]
        want = targets[cpu] // 1000
        got = now.get(cpu, 0)
        # The CPU firmware can run a core a little below the lock (Ryzen 9 7950X: 4304 MHz for 4501,
        # 2729 for 3000), but always at the same frequency. That is stable, so it is no problem.
        # Faster than the lock: boost is still on, or the CPU does not go this low.
        ok = bool(got) and got <= want + max(50, want * 0.03)
        cores.append({"cpus": siblings, "target_mhz": want, "measured_mhz": got or None, "ok": ok})
        if not got:
            warn(f"cpu{cpu}: cannot measure the frequency under load")
        elif not ok:
            warn(f"cpu{cpu}: measured {got} MHz under load, faster than the lock {want} MHz. "
                 "Boost is still on, or the CPU does not go this low.")

    # A benchmark runs on the CPUs that the user named, as with taskset. The lock covers the
    # whole physical core, because SMT siblings share one frequency. Without --cpu: all of it.
    pin = cpus if args.cpu is None or args.cpu.strip() == "all" else sorted(set(parse_cpu_list(args.cpu)))
    taskset = f"taskset -c {format_cpu_list(pin)}"
    if args.json:
        print_json({
            "ok": True,
            "command": "lock",
            "cpus": cpus,
            "pin_cpus": pin,
            "cores": cores,
            "boost_off": scope,
            "governor": ",".join(sorted(governors)),
            "taskset": taskset,
            "undo": "cputune reset",
        })
        return

    for core in cores:
        mark = paint("✓", BOLD, GREEN) if core["ok"] else paint("✗", BOLD, RED)
        say(
            paint("◆ ", BOLD, MAGENTA)
            + f"Locked cpu {paint(format_cpu_list(core['cpus']), BOLD, WHITE)} at "
            + paint(f"{core['target_mhz']} MHz", BOLD, MAGENTA)
            + paint(f"   measured under load: {core['measured_mhz'] or '?'} MHz ", GRAY)
            + mark
            + below_note(core)
        )
    boost_text = {
        "core": f"off for cpu {format_cpu_list(cpus)} only",
        "global": paint("off for ALL cores", BOLD, YELLOW) + paint(" (this driver has one global switch)", GRAY),
        "none": paint("unchanged (no switch)", YELLOW),
    }[scope]
    say(f"  {paint('boost', GRAY)}     {boost_text}")
    say(f"  {paint('governor', GRAY)}  {','.join(sorted(governors))}")
    say()
    say(f"Run a benchmark:  {paint(taskset + ' ./bench', BOLD, WHITE)}")
    say(f"Undo:             {paint('cputune reset', BOLD, WHITE)}")


def below_note(core: dict) -> str:
    """A note when the core runs clearly below the lock: the CPU firmware sets this frequency."""
    want, got = core["target_mhz"], core["measured_mhz"]
    if not got or got >= want - max(50, want * 0.03):
        return ""
    return paint(f" ({(want - got) / want:.0%} below the lock: the CPU firmware sets this frequency)", GRAY)


def cmd_limit(args: argparse.Namespace) -> None:
    if args.min is None and args.max is None:
        die("give --min, --max or both. Example: cputune limit --max 2400")
    ensure_root(args)
    cpus = select_cpus(args.cpu, freq_cpus())
    save_state(cpus, exclusive=False)
    ranges = []
    for cpu in cpus:
        new_min = target_khz(cpu, args.min if args.min is not None else "min", clamp=True)
        new_max = target_khz(cpu, args.max if args.max is not None else "max", clamp=True)
        new_min = min(new_min, new_max)  # --min above --max: --max wins
        set_range(cpu, new_min, new_max)
        ranges.append({"cpu": cpu, "min_mhz": new_min // 1000, "max_mhz": new_max // 1000})

    if args.json:
        print_json({"ok": True, "command": "limit", "cpus": cpus, "ranges": ranges, "undo": "cputune reset"})
        return
    say("\n".join(render_show(get_cores(), system_info(), False)))


def cmd_reset(args: argparse.Namespace) -> None:
    ensure_root(args)
    errors: list[str] = []
    if not state_exists():
        # Nothing saved, for example after a change by another tool: open the full range.
        cpus = freq_cpus()
        for cpu in cpus:
            set_range(cpu, must_khz(cpu, "cpuinfo_min_freq"), must_khz(cpu, "cpuinfo_max_freq"), errors)
        if errors:
            die("; ".join(errors))
        if args.json:
            print_json({"ok": True, "command": "reset", "restored": False, "cpus": cpus})
        else:
            say("Nothing saved to restore. Opened the full frequency range on all cores.")
            say(paint("Governor and boost are as they were.", GRAY))
        return

    state = load_state()
    # Boost first: with boost off, the hardware range can be too small for the old maximum.
    for path, value in state["boost"].items():
        if not is_boost_switch(Path(path)):
            warn(f"{STATE_SHOWN} names {path}, which is not a boost switch. Skipped.")
        elif value is not None:
            write(Path(path), value, errors)
    restored = []
    for cpu_text, saved in state["cpus"].items():
        cpu = int(cpu_text)
        if not fdir(cpu).is_dir():
            warn(f"cpu{cpu} has no cpufreq now, skipped")
            continue
        if saved.get("governor"):
            write(fdir(cpu) / "scaling_governor", saved["governor"], errors)
        set_range(cpu, saved["min"], saved["max"], errors)
        if saved.get("epp") and read_str(fdir(cpu) / "energy_performance_preference") != saved["epp"]:
            epp_errors: list[str] = []
            write(fdir(cpu) / "energy_performance_preference", saved["epp"], epp_errors)
            for e in epp_errors:
                warn(e)
        restored.append(cpu)
    if errors:
        die("; ".join(errors) + f". {STATE_SHOWN} stays, so you can try again.")
    STATE_FILE.unlink()

    if args.json:
        print_json({"ok": True, "command": "reset", "restored": True, "cpus": sorted(restored)})
    else:
        cpus = format_cpu_list(restored)
        say(paint("✓ ", BOLD, GREEN) + f"Restored cpu {cpus}: boost, governor and frequency range.")


def throttle_count(cpu: int) -> int | None:
    """How often the core of this CPU and its package were too hot and ran slower, since boot.
    None: the kernel does not count it (only Intel CPUs have these counters)."""
    counts = [read_int(CPU_BASE / f"cpu{cpu}/thermal_throttle/{name}")
              for name in ("core_throttle_count", "package_throttle_count")]
    known = [n for n in counts if n is not None]
    return sum(known) if known else None


def lock_settings(cpus: list[int]) -> dict[str, str | None]:
    """The files that a lock sets, with their values: run checks that no other program changes them."""
    paths = {fdir(cpu) / name for cpu in cpus for name in
             ("scaling_min_freq", "scaling_max_freq", "scaling_governor", "energy_performance_preference")}
    paths |= {switch[0] for cpu in cpus if (switch := boost_switch(cpu))}
    return {str(path): read_str(path) for path in sorted(paths) if path.exists()}


def sample_frequencies(cpus: list[int], stop: threading.Event, samples: dict[int, list[int]]) -> None:
    """Reads the frequency of the CPUs every 0.5 s until stop is set, and once more after that.

    cpuinfo_avg_freq (new kernels) is the average that the hardware counted; it has no
    value while a CPU sleeps. This runs in a thread of cputune, not on the benchmark CPUs.
    """
    reader = FdReader()
    files = {}
    for cpu in cpus:
        avg = fdir(cpu) / "cpuinfo_avg_freq"
        files[cpu] = avg if avg.exists() else fdir(cpu) / "scaling_cur_freq"
    try:
        while True:
            stopped = stop.wait(0.5)
            for cpu, path in files.items():
                if khz := reader.int(path):
                    samples[cpu].append(khz // 1000)
            if stopped:
                return
    finally:
        reader.close()


def cmd_run(args: argparse.Namespace) -> None:
    if not args.command:
        die("give the command after --. Example: cputune run -- ./bench")
    problems: list[str] = []  # everything that can make the result vary

    def problem(text: str) -> None:
        problems.append(text)
        warn(text)

    # 1. Checks, as the user and before any change. lock reports a bad --cpu.
    try:
        check_cpus = select_cpus(args.cpu, [] if args.cpu else list(default_lock_core(get_cores()).cpus))
    except Error:
        check_cpus = []
    if check_cpus:
        for item in run_checks(check_cpus, 0.3):
            if item["level"] == "warn" and item["name"] != "changed":  # lock reports "changed"
                problem(f"{item['text'][0].lower()}{item['text'][1:]} {item['fix']}")

    # 2. Lock, as root.
    lock = ["lock", "--exclusive", "--json", f"--color={'always' if COLOR else 'never'}"]
    if args.freq is not None:
        lock.append(str(args.freq))
    if args.cpu is not None:
        lock += ["--cpu", args.cpu]

    existed = state_exists()
    result = run_root(lock, capture=True)
    try:
        locked = json.loads(result.stdout)
    except ValueError:
        locked = {"ok": False, "error": result.stdout.strip() or "lock failed"}
    if result.returncode != 0 or not locked.get("ok"):
        if not existed and state_exists():  # the lock changed something before it failed
            run_root(["reset", "--json", "--color=never"], capture=True)
        die(f"lock failed: {locked.get('error', 'unknown error')}")

    def reset() -> bool:
        try:
            done = run_root(["reset", "--json", "--color=never"], capture=True)
        except Error as e:
            done = subprocess.CompletedProcess([], 1, str(e))
        if done.returncode != 0:
            warn(f"reset failed. Undo by hand with: cputune reset\n{done.stdout.strip()}")
        return done.returncode == 0

    cpus = locked["cpus"]
    cores = locked["cores"]
    pin = locked.get("pin_cpus", cpus)
    unverified = [c for c in cores if not c["ok"]]
    for core in unverified:
        problems.append(f"cpu {format_cpu_list(core['cpus'])}: measured {core['measured_mhz'] or '?'} MHz "
                        f"under load, faster than the lock {core['target_mhz']} MHz")  # lock warned already
    if args.strict and unverified:
        reset()
        die(f"the lock is not verified: {'; '.join(problems[-len(unverified):])}. "
            "With --strict, the command does not run.")

    mhz = ",".join(str(c["target_mhz"]) for c in cores)
    measured = ",".join(str(c["measured_mhz"]) for c in cores)
    if not args.json:
        say(
            paint("cputune: ", GRAY)
            + f"locked cpu {paint(format_cpu_list(cpus), BOLD, WHITE)} at {paint(mhz + ' MHz', BOLD, MAGENTA)}"
            + paint(f" (measured {measured} MHz), running on cpu {format_cpu_list(pin)}: {' '.join(args.command)}",
                    GRAY)
        )

    def stop(signum, frame):
        raise SystemExit(128 + signum)

    signal.signal(signal.SIGTERM, stop)
    signal.signal(signal.SIGHUP, stop)
    # 3. Run the command on the pinned CPUs. Meanwhile, cputune samples the frequency from other CPUs.
    groups = [[cpu for cpu in core["cpus"] if cpu in pin] for core in cores]  # where the command runs
    throttled_before = [throttle_count(core["cpus"][0]) for core in cores]
    settings = lock_settings(cpus)
    samples: dict[int, list[int]] = {cpu: [] for group in groups for cpu in group}
    stop_sampling = threading.Event()
    sampler = threading.Thread(target=sample_frequencies, args=(sorted(samples), stop_sampling, samples))
    returncode = 1
    try:
        allowed: set[int] = set()
        try:
            allowed = os.sched_getaffinity(0)
            os.sched_setaffinity(0, pin)
        except OSError as e:
            if not TEST_MODE:
                die(f"cannot pin to cpu {format_cpu_list(pin)}: {e.strerror}")
        env = dict(os.environ, CPUTUNE_CPUS=format_cpu_list(pin))
        try:
            proc = subprocess.Popen(args.command, env=env)
        except OSError as e:
            die(f"cannot run {args.command[0]}: {e.strerror}")
        try:  # cputune itself leaves the locked cores to the command
            if others := allowed - set(cpus):
                os.sched_setaffinity(0, others)
        except OSError:
            pass
        sampler.start()
        try:
            returncode = proc.wait()
        except BaseException:
            proc.kill()
            proc.wait()
            raise
        finally:
            stop_sampling.set()
            sampler.join()

        # 4. Did the frequency stay at the lock?
        changed = [path for path, value in settings.items() if read_str(Path(path)) != value]
        if changed:
            problem("another program changed the lock while the command ran: "
                    f"{', '.join(changed)}. Check with: cputune check")
        for core, group, before in zip(cores, groups, throttled_before):
            values = [mhz for cpu in group for mhz in samples[cpu]]
            core["run_avg_mhz"] = round(sum(values) / len(values)) if values else None
            core["run_min_mhz"] = min(values) if values else None
            after = throttle_count(core["cpus"][0])
            core["throttled"] = after - before if after is not None and before is not None else None
            # Compare with the frequency that lock measured: the firmware can hold a lock below the target.
            where, avg = format_cpu_list(core["cpus"]), core["run_avg_mhz"]
            want = min(core["measured_mhz"] or core["target_mhz"], core["target_mhz"])
            if not args.json:
                text = f"cpu {where} ran at {avg or '?'} MHz (lowest {core['run_min_mhz'] or '?'} MHz)"
                if core["throttled"] == 0:
                    text += ", not throttled"
                say(paint("cputune: ", GRAY) + text)
            if avg is not None and abs(avg - want) > max(50, want * 0.03):
                why = "too hot, or at its power limit" if avg < want else "did another program change the lock?"
                problem(f"cpu {where} ran at {avg} MHz on average while the command ran, but at {want} MHz "
                        f"after the lock ({why})")
            if core["throttled"]:
                problem(f"cpu {where} was too hot and ran slower {core['throttled']} times while the command ran")
    finally:
        if reset() and not args.json:
            say(paint("cputune: ", GRAY) + f"reset done. The command exited with {returncode}.")

    stable = not problems
    if not args.json and not stable:
        say(paint("cputune: ", GRAY) + paint("the result may vary: see the warnings above.", BOLD, YELLOW))
    if args.json:
        print_json({
            "ok": True,
            "command": "run",
            "cpus": cpus,
            "pin_cpus": pin,
            "cores": cores,
            "exit_code": returncode,
            "stable": stable,
        } | ({"warnings": locked.get("warnings", []) + WARNINGS} if locked.get("warnings") or WARNINGS else {}))
    sys.exit(returncode)


SUDOERS_FILE = "/etc/sudoers.d/cputune"


def owned_by_root(path: Path) -> bool:
    """True when only root can change the file.

    Root must own the file and every folder above it, and no one else may write
    them: a user who can write any folder on the way can rename it and put
    another file in its place. Symlinks are resolved first.
    """
    try:
        real = path.resolve(strict=True)
        for p in (real, *real.parents):
            st = os.stat(p)
            if st.st_uid != 0 or st.st_mode & 0o022:
                return False
    except (OSError, RuntimeError):
        return False
    return True


def sudo_works(path: Path) -> bool | None:
    """True when this user can run path as root without a password. None: cannot check."""
    if TEST_MODE or not shutil.which("sudo"):
        return None
    try:
        # -k: ignore a password that sudo remembers, so that only a NOPASSWD rule passes.
        result = subprocess.run(
            ["sudo", "-k", "-n", str(path), "--version"],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return result.returncode == 0


def self_command() -> str:
    """How the user calls this script: "cputune" when the shell finds this file, else its path."""
    found = shutil.which("cputune")
    if found and Path(found).resolve() == Path(script_path()).resolve():
        return "cputune"
    return shlex.quote(script_path())


def sudoers_status() -> dict:
    """What is set up. target is the copy that the rule names: always one that only root can change."""
    user = pwd.getpwuid(os.getuid()).pw_name  # not $USER: the environment can name anyone
    script = Path(script_path())
    target = script if owned_by_root(script) else SYSTEM_BIN / "cputune"
    installed = owned_by_root(target)
    version, newest = file_version(target), file_version(script)
    return {
        "user": user,
        "path": str(target),
        "installed": installed,
        "version": version,
        "outdated": installed and version_key(version) < version_key(newest),
        "works": sudo_works(target) if installed else None,
        "rule": f"{user} ALL=(root) NOPASSWD: {target}",
        "file": SUDOERS_FILE,
        "setup": f"{self_command()} install --no-password",
        "undo": f"sudo rm {SUDOERS_FILE}",
    }


def render_sudoers(status: dict) -> list[str]:
    ok, bad, unknown = paint("✓", BOLD, GREEN), paint("✗", BOLD, RED), paint("?", BOLD, YELLOW)
    path = paint(status["path"], BOLD, WHITE)
    lines = [
        "lock, run, limit and reset need root. In a terminal, sudo asks for your password.",
        "Scripts and AI agents have no terminal: they need a sudo rule that lets them run",
        "cputune as root without a password.",
        "",
        f"  {ok if status['installed'] else bad} {path} "
        + ("is owned by root" if status["installed"] else "does not exist, or a user can change it"),
        *([f"  {bad} {path} is version {status['version']}: older than this copy"] if status["outdated"] else []),
        {True: f"  {ok} sudo runs it without a password",
         False: f"  {bad} sudo asks for a password",
         None: f"  {unknown} the sudo rule is not checked"}[status["works"]],
        "",
    ]
    if status["works"] and not status["outdated"]:
        lines.append(paint("Everything is set up.", BOLD, GREEN))
    else:
        does = []
        if not status["installed"] or status["outdated"]:
            does.append(f"install the newest cputune to {status['path']}, owned by root")
        if not status["works"]:
            does += [f"add this rule to {status['file']}, after visudo checked it:", "  " + status["rule"]]
        lines += [
            "Set it up with one command:",
            "  " + paint(status["setup"], BOLD, WHITE),
            "",
            "It uses sudo to:",
            *(f"  {line}" for line in does),
        ]
    lines += [
        "",
        paint("The rule names a copy that only root can change. Otherwise every program that", GRAY),
        paint("runs as you could change cputune, and so run anything as root.", GRAY),
        paint(f"Undo: {status['undo']}", GRAY),
    ]
    return lines


def sudoers_install(status: dict) -> list[str]:
    """Install the root-owned copy when it is missing or old, then the checked rule. Returns what it did."""
    done = []
    if not status["installed"] or status["outdated"]:
        target, version, origin, notes = install_copy(system=True, no_check=False)
        done += [f"Installed cputune {version} from {origin} to {target}", *notes]
    if status["works"]:
        return done
    rule = f"# {SUDOERS_FILE}: {status['user']} can run {status['path']} as root without a password.\n"
    rule += status["rule"] + "\n"
    if not TEST_MODE:
        fd, name = tempfile.mkstemp(prefix="cputune.sudoers.")
        with os.fdopen(fd, "w") as f:
            f.write(rule)
        try:
            # A broken file in /etc/sudoers.d can break sudo: check it before it goes there.
            if subprocess.run([*sudo_prefix(), "visudo", "-cqf", name]).returncode != 0:
                die("visudo rejects the rule. Nothing is installed.")
        finally:
            os.unlink(name)
    sudo_install(rule.encode(), ROOT / SUDOERS_FILE.lstrip("/"), "440")
    done.append(f"Installed the rule in {SUDOERS_FILE}")
    return done


def cmd_sudoers(args: argparse.Namespace) -> None:
    status = sudoers_status()
    if args.rule:
        if not status["installed"]:
            warn(f"the rule is for {status['path']}. Install cputune there first: "
                 f"{self_command()} install --system")
        say(f"# {SUDOERS_FILE}: {status['user']} can run {status['path']} as root without a password.")
        say(status["rule"])
        return
    legacy_note()
    if args.install:
        done = [] if status["works"] and not status["outdated"] else sudoers_install(status)
        status = sudoers_status()
        if status["works"] is False:
            warn("the rule is installed, but sudo still asks for a password. "
                 "Check the other rules in /etc/sudoers and /etc/sudoers.d.")
        status["done"] = done
    if args.json:
        print_json({"ok": True, "command": "install" if getattr(args, "no_password", False) else "sudoers",
                    **status})
        return
    for line in status.get("done", []):
        say(paint("✓ ", BOLD, GREEN) + line)
    if args.install and status["works"] is not False:
        if status["works"]:
            say(paint("✓ ", BOLD, GREEN) + f"{status['user']} can run {status['path']} as root without a password.")
        say(paint(f"Undo: {status['undo']}", GRAY))
        return
    say("\n".join(render_sudoers(status)))


# ------------------------------------------------------------------ install, update

VERSION_LINE = re.compile(rb'^__version__ = "([^"]+)"', re.MULTILINE)


def source_version(source: bytes) -> str | None:
    """The version of a cputune script, read from its text. The script is not run."""
    m = VERSION_LINE.search(source)
    return m[1].decode() if m else None


def version_key(version: str | None) -> tuple[int, ...]:
    """Dotted versions as numbers, so that 1.10.0 is newer than 1.9.0."""
    try:
        return tuple(int(part) for part in (version or "").split("."))
    except ValueError:
        return ()


def check_source(source: bytes, origin: str) -> None:
    """Make sure that source is a cputune script that this Python can compile."""
    if not source.startswith(b"#!/usr/bin/env python3\n") or source_version(source) is None:
        die(f"{origin} is not a cputune script")
    try:
        compile(source, "cputune", "exec")
    except (SyntaxError, ValueError) as e:
        die(f"{origin} does not compile with Python {sys.version.split()[0]}: {e}")


def download() -> bytes:
    """The newest cputune from GitHub. Tests can use another URL."""
    import urllib.request  # here, not at the top: it makes every start 15 ms slower

    url = os.environ.get("CPUTUNE_SOURCE_URL", SOURCE_URL) if TEST_MODE else SOURCE_URL
    try:
        with urllib.request.urlopen(url, timeout=30) as response:
            source = response.read(10_000_000)
    except (OSError, ValueError) as e:
        die(f"cannot download {url}: {e}")
    check_source(source, url)
    return source


def local_source() -> bytes | None:
    """The bytes of this script. None when it runs from stdin: curl ... | python3 - install"""
    path = Path(script_path())
    return path.read_bytes() if path.is_file() else None


def replace_file(target: Path, source: bytes) -> None:
    """Write target in one step: a reader sees the old file or the new file, never a part.

    os.replace also replaces a symlink itself, never the file that it points to.
    """
    try:
        # mkstemp: a new file with a random name (O_EXCL), never a symlink that someone put there.
        fd, name = tempfile.mkstemp(prefix=f".{target.name}.", suffix=".tmp", dir=target.parent)
    except OSError as e:
        die(f"cannot write {target}: {e.strerror}")
    tmp = Path(name)
    try:
        with os.fdopen(fd, "wb") as f:
            f.write(source)
        tmp.chmod(0o755)
        os.replace(tmp, target)
    except OSError as e:
        tmp.unlink(missing_ok=True)
        die(f"cannot write {target}: {e.strerror}")


def in_git_checkout(path: Path) -> bool:
    return any((parent / ".git").exists() for parent in path.parents)


def path_note(target: Path) -> None:
    """Warn when the shell does not find target as "cputune"."""
    if TEST_MODE:
        return
    folders = [Path(p) for p in os.environ.get("PATH", "").split(os.pathsep) if p]
    if target.parent not in folders:
        warn(f"{target.parent} is not in your PATH. Add it, or call {target} directly.")
    elif (found := shutil.which("cputune")) and Path(found) != target:
        warn(f"your shell finds {found} first. Delete it, or call {target} directly.")


def sudo_prefix() -> list[str]:
    """sudo, which asks for a password in a terminal, and never waits for one without a terminal."""
    return ["sudo"] if sys.stdin.isatty() else ["sudo", "-n"]


def sudo_install(source: bytes, target: Path, mode: str) -> None:
    """Install source as target, owned by root. Uses plain sudo, never the cputune rule:
    the rule must never let a user install a file of their choice as root."""
    fd, name = tempfile.mkstemp(prefix="cputune.")
    tmp = Path(name)
    with os.fdopen(fd, "wb") as f:
        f.write(source)
    try:
        if TEST_MODE:  # no sudo in tests
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(tmp, target)
            target.chmod(int(mode, 8))
            return
        cmd = [*sudo_prefix(), "install", "-m", mode, "-o", "root", "-g", "root", str(tmp), str(target)]
        if subprocess.run(cmd).returncode != 0:
            die(f"cannot install {target}: sudo install failed")
    finally:
        tmp.unlink()


def install_copy(system: bool, no_check: bool) -> tuple[Path, str | None, str, list[str]]:
    """Install the newer of this file and the latest release. Returns path, version, origin, notes.

    Only one copy stays installed: two copies get different versions, and the shell finds
    the wrong one (the sudo rule names only /usr/local/bin/cputune). So when
    /usr/local/bin/cputune exists, a user install updates that copy, and a system install
    deletes ~/.local/bin/cputune.
    """
    notes = []
    if not system and (SYSTEM_BIN / "cputune").exists():
        system = True
        notes.append(f"{SYSTEM_BIN / 'cputune'} exists: updated that copy, not one in {USER_BIN}")
    local = local_source()
    source, origin = local, "this file"
    if not no_check or local is None:
        try:
            remote = download()
        except Error as e:
            if local is None:
                raise
            warn(f"{e}. Installs this file instead.")
        else:
            if local is None or version_key(source_version(remote)) > version_key(source_version(local)):
                source, origin = remote, "GitHub"
    assert source is not None
    target = (SYSTEM_BIN if system else USER_BIN) / "cputune"
    if target.is_file() and not target.is_symlink() and target.read_bytes() == source:
        pass  # nothing to do
    elif system and os.geteuid() != 0:
        sudo_install(source, target, "755")
    else:
        target.parent.mkdir(parents=True, exist_ok=True)
        replace_file(target, source)
    if system:
        notes += remove_user_copy()
    return target, source_version(source), origin, notes


def remove_user_copy() -> list[str]:
    """Delete ~/.local/bin/cputune, which would hide /usr/local/bin/cputune in PATH. Only a cputune
    script (or a link to one, or a broken link) goes; a symlink goes, not the file it points to."""
    user_copy = USER_BIN / "cputune"
    if not (user_copy.is_symlink() or user_copy.exists()):
        return []
    if user_copy.exists() and file_version(user_copy) is None:
        warn(f"{user_copy} is not a cputune script, so it stays. It hides {SYSTEM_BIN / 'cputune'} in PATH.")
        return []
    try:
        user_copy.unlink()
    except OSError as e:
        warn(f"cannot delete {user_copy}: {e.strerror}. It hides {SYSTEM_BIN / 'cputune'} in PATH.")
        return []
    return [f"Deleted {user_copy}: only the copy in {SYSTEM_BIN} stays"]


def legacy_note() -> None:
    """Version 2.0.0 renamed cpu-tune to cputune. Old copies do not update any more, and
    version 1.0.0 lets "sudo cpu-tune run" start any program: they must go, with their rule."""
    old = [str(p) for p in (USER_BIN / "cpu-tune", SYSTEM_BIN / "cpu-tune") if p.exists()]
    if old:
        warn(f"cpu-tune is called cputune now. Delete the old copies and the old sudo rule: "
             f"sudo rm -f {' '.join(old)} /etc/sudoers.d/cpu-tune")


def cmd_install(args: argparse.Namespace) -> None:
    """Installs the newest release, or updates to it. Replaces "update" and "sudoers --install"."""
    if args.no_password:
        args.install, args.rule = True, False
        cmd_sudoers(args)
        return
    target, version, origin, notes = install_copy(args.system, args.no_check)
    path_note(target)  # before the output, so that --json has the warnings
    legacy_note()
    if args.json:
        print_json({"ok": True, "command": "install", "path": str(target), "version": version, "source": origin,
                    "notes": notes})
    else:
        where = paint(str(target), BOLD, WHITE)
        say(paint("✓ ", BOLD, GREEN) + f"Installed cputune {version} from {origin} to {where}")
        for note in notes:
            say(paint("✓ ", BOLD, GREEN) + note)


def cmd_update(args: argparse.Namespace) -> None:
    path = Path(script_path()).resolve()
    if not path.is_file():
        die("cputune does not run from a file. Install it with: cputune install")
    if in_git_checkout(path):
        die(f"{path} is in a git checkout. Update it with: git pull")
    if not (os.access(path, os.W_OK) and os.access(path.parent, os.W_OK)):
        # A copy owned by root, for example /usr/local/bin. As root, update
        # downloads the file itself: it installs nothing that a user gives it.
        ensure_root(args)
    old = source_version(path.read_bytes())
    source = download()
    new = source_version(source)
    updated = version_key(new) > version_key(old)
    if updated:
        replace_file(path, source)
    if not args.json:
        if updated:
            say(paint("✓ ", BOLD, GREEN) + f"Updated {path}: cputune {old} -> {paint(new or '?', BOLD, WHITE)}")
        else:
            say(paint("✓ ", BOLD, GREEN) + f"cputune {old} is up to date (GitHub has {new}).")
    root = update_root_copy(path, new, args.json)
    if args.json:
        print_json({"ok": True, "command": "update", "path": str(path), "old_version": old,
                    "new_version": new, "updated": updated, "root_copy": root})


def update_root_copy(path: Path, newest: str | None, quiet: bool) -> dict | None:
    """Update the root-owned /usr/local/bin/cputune too: lock, limit and reset run that copy as root.

    Root runs that copy's own update, which downloads the file itself.
    """
    system = SYSTEM_BIN / "cputune"
    if os.geteuid() == 0 or path == system.resolve() or not owned_by_root(system):
        return None
    if version_key(file_version(system)) >= version_key(newest):
        return {"path": str(system), "updated": False}
    try:
        result = run_root(["update", "--json"] if quiet else ["update"], capture=quiet)
    except Error as e:
        warn(f"cannot update {system}: {e}. Run: sudo {system} update")
        return {"path": str(system), "updated": False, "error": str(e)}
    if result.returncode != 0:
        warn(f"cannot update {system}. Run: sudo {system} update")
    return {"path": str(system), "updated": result.returncode == 0}


